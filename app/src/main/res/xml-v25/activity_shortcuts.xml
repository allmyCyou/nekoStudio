<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">

    <shortcut
        android:shortcutId="running_services"
        android:enabled="true"
        android:icon="@drawable/ic_running_services"
        android:shortcutShortLabel="@string/shortlabel_string_running">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.android.settings"
            android:targetClass="com.android.settings.SubSettings">
            <extra
                android:name=":settings:show_fragment"
                android:value="com.android.settings.applications.RunningServices" />
        </intent>
    </shortcut>

    <shortcut
        android:shortcutId="magnification_settings"
        android:enabled="true"
        android:icon="@drawable/ic_magnification"
        android:shortcutShortLabel="@string/shortlabel_string_magnification">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.android.settings"
            android:targetClass="com.android.settings.Settings$ConfigureNotificationSettingsActivity" />
    </shortcut>

    <shortcut
        android:shortcutId="reduce_bright_colors"
        android:enabled="true"
        android:icon="@drawable/ic_extra_dim"
        android:shortcutShortLabel="@string/shortlabel_string_dim">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.android.settings"
            android:targetClass="com.android.settings.Settings$ReduceBrightColorsSettingsActivity" />
    </shortcut>

</shortcuts>
