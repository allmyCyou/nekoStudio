        <package android:name="com.android.scheduling" />
        <package android:name="com.android.resolv" />
        <package android:name="com.android.profiling" />
        <package android:name="com.android.ondevicepersonalization" />
        <package android:name="com.android.media.swcodec" />
        <package android:name="com.android.vndk" />
        <package android:name="com.android.vndk.v30" />
        <package android:name="com.android.vndk.v31" />
