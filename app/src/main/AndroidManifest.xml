        <package android:name="com.android.tzdata" />
        <package android:name="com.android.sdkext" />
        <package android:name="com.android.runtime" />
    </queries>
    <queries>
        <intent>
            <action
                android:name="android.intent.action.VIEW" />
            <category
                android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action
                android:name="android.intent.action.VIEW" />
            <category
                android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="http" />
        </intent>
        <intent>
            <action
                android:name="android.intent.action.VIEW" />
            <category
                android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="ftp" />
        </intent>
        <intent>
            <action
                android:name="android.intent.action.VIEW" />
            <category
                android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="sftp" />
        </intent>
        <intent>
            <action
                android:name="android.intent.action.VIEW" />
            <category
                android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="ssh" />
        </intent>
        <intent>
            <action
                android:name="android.intent.action.VIEW" />
            <category
                android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="vpn" />
        </intent>
    </queries>
    <!-- 如果 application 设置了 android:process, 但是 activity、service、provider、receiver 没有设置 android:process, 就得跟着 application 跑在同一个进程里 -->
    <!-- 通过 android:process 设置的进程来共享同一进程，以冒号开头的是应用私有进程，以非冒号开头的是同签名应用的共享进程 -->
    <application
        android:process=":task"
        android:largeHeap="true"
        android:name="BypassApi"
        android:allowBackup="true"
        android:directBootAware="true"
        android:usesNonSdkApi="true"
        android:usesCleartextTraffic="true"
        android:resizeableActivity="true"
        android:appCategory="productivity"
        android:hardwareAccelerated="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:enableOnBackInvokedCallback="true"
        android:requestLegacyExternalStorage="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:banner="@drawable/android_tv_banner"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        tools:targetApi="37">
        <!-- uses-native-library Android 12+ -->
        <uses-native-library
            android:name="com.android.future.usb.accessory"
            android:required="false" />
        <uses-native-library
            android:name="com.android.location.provider"
            android:required="false" />
        <meta-data 
            android:name="android.software.leanback.supports_touch"
            android:value="true" />
        <meta-data 
            android:name="msg_keys"
            android:value="OpenSSL_X509" />
        <meta-data 
            android:name="app_logs"
            android:value="@string/app_logs" />
        <meta-data 
            android:name="ANDROID_ABI_INFO"
            android:resource="@xml/android_abi_version" />
        <meta-data 
            android:name="ANDROID_SDK_INFO"
            android:resource="@xml/android_sdk_version" />
        <meta-data 
            android:name="ANDROID_KERNEL_INFO"
            android:resource="@xml/android_gki_kernel_version" />
        <meta-data 
            android:name="ANDROID_RAMDISK_INFO"
            android:resource="@xml/android_ramdisk_api_level" />
        <meta-data 
            android:name="Shell"
            android:value="Shell, adb Shell, Root Shell" />
        <meta-data 
            android:name="APP_USB_DEVICE_FILTER_XML"
            android:resource="@xml/usb_device_filter" />
        <meta-data 
            android:name="APP_USB_ACCESSORY_FILTER_XML"
            android:resource="@xml/accessory_filter" />
        <!-- activity-alias 适配 Pixel 系列的类原生系统桌面 -->
        <activity-alias
             android:name="aliasActivity"
             android:exported="true"
             android:targetActivity=".MainActivity">
            <intent-filter>
                <action
                    android:name="android.intent.action.MAIN" />
                <category
                    android:name="android.intent.category.LAUNCHER" />
                <category
                    android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <meta-data 
                android:name="android.app.shortcuts"
                android:resource="@xml/activity_shortcuts" />
        </activity-alias>
        <activity 
            android:name="MainActivity"
            android:directBootAware="true"
            android:showForAllUsers="false"
            android:hardwareAccelerated="true"
            android:supportsPictureInPicture="true"
            android:windowSoftInputMode="adjustPan"
            android:canDisplayOnRemoteDevices="false"
            android:launchMode="singleInstancePerTask"
            android:persistableMode="persistNever"
            android:theme="@style/AppTheme"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden"
            android:permission="com.adb.kitty.USE_PRIVATE_API"
            android:exported="true">
            <!-- USB主机模式 -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <!-- USB配件模式 -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_ACCESSORY_ATTACHED" />
            </intent-filter>
            <!-- USB主机模式配置 -->
            <meta-data 
                 android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                 android:resource="@xml/usb_device_filter" />
            <!-- USB配件模式配置 -->
            <meta-data
                 android:name="android.hardware.usb.action.USB_ACCESSORY_ATTACHED"
                 android:resource="@xml/accessory_filter" />
        </activity>
        <!-- Service type: 连接设备、远程消息、特殊用途、健康、相机、位置、媒体、媒体投屏、麦克风 -->
        <service 
            android:name=".service.AdbSessionService"
            android:foregroundServiceType="connectedDevice|remoteMessaging|specialUse|health|camera|location|mediaPlayback|mediaProjection|microphone"
            android:exported="true"
            android:directBootAware="true"
            android:permission="com.adb.kitty.USE_PRIVATE_API" >
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Terminal or Shell or AppOps" />
        </service>
        <provider
            android:name=".provider.AppDataFilesProvider"
            android:authorities="${applicationId}.documents"
            android:exported="true"
            android:directBootAware="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="true"
            android:directBootAware="true"
            android:permission="android.permission.RECEIVE_BOOT_COMPLETED" >
            <intent-filter>
                <!-- 设备启动完成且用户已解锁 (凭据加密存储已被解锁) -->
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- 设备已启动但用户尚未解锁 (Direct Boot 模式) -->
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <!-- 本应用自身升级/覆盖安装完成 (无需特殊权限) -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/uncompressed_dex_opt_out" />
        </provider>
    </application>
</manifest>