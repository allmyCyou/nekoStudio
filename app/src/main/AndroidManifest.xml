    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- Application 私有 API -->
    <uses-permission android:name="com.adb.kitty.USE_PRIVATE_API" />
    <permission
        android:name="com.adb.kitty.USE_PRIVATE_API"
        android:description="@string/permission_description"
        android:icon="@drawable/ic_launcher_foreground"
        android:label="@string/permission_label"
        android:protectionLevel="signature" />

    <queries>
        <package android:name="android" />
        <package android:name="com.adb.kitty" />
        <package android:name="com.android.browser" />
        <package android:name="com.android.chrome" />
        <package android:name="org.telegram.messenger.beta" />
        <package android:name="org.telegram.messenger.web" />
        <package android:name="org.telegram.messenger" />
        <package android:name="tw.nekomimi.nekogram" />
        <package android:name="com.twitter.android" />
        <package android:name="com.android.vending" />
        <package android:name="com.google.android.gms" />
        <package android:name="com.android.ipsec" />
        <package android:name="com.android.art" />
